{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyEnv",
  "version": "1.0.1",
  "identifier": "com.proxyenv.portable",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ProxyEnv 代理开关",
        "width": 460,
        "height": 760,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
